<?xml version="1.0" encoding="utf-8"?>
<!--
  Multi-view tile. texture_view draws the video inside the app window instead of
  giving every tile its own hardware video layer. Amlogic chips (onn 4K sticks)
  have a single video overlay, so 2+ SurfaceViews fall back to GPU composition at
  4K output and drop to ~10 fps.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/multiview_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="when_playing"
    app:shutter_background_color="@android:color/black" />
